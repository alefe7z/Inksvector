<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Encaixar e Alinhar</name>
  <id>org.inksvector.grids.align</id>
  <param name="mode" type="string" gui-hidden="true">align</param>
  <effect>
    <object-type>all</object-type>
    <effects-menu><submenu name="Grades e Linhas"/></effects-menu>
    <menu-tip>Alinha os centros dos objetos selecionados no eixo vertical do primeiro objeto.</menu-tip>
    <icon>inksvector_grids_align.svg</icon>
  </effect>
  <script><command location="inx" interpreter="python">inksvector_grids.py</command></script>
</inkscape-extension>
