<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Grade de Cruz</name>
  <id>org.inksvector.grids.cross</id>
  <param name="mode" type="string" gui-hidden="true">cross</param>
  <effect>
    <object-type>all</object-type>
    <effects-menu><submenu name="Grades e Linhas"/></effects-menu>
    <menu-tip>Adiciona guias centrais horizontal e vertical.</menu-tip>
    <icon>inksvector_grids_cross.svg</icon>
  </effect>
  <script><command location="inx" interpreter="python">inksvector_grids.py</command></script>
</inkscape-extension>
