<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Encaixar nas Guias</name>
  <id>org.inksvector.grids.snap-guides</id>
  <param name="mode" type="string" gui-hidden="true">snap-guides</param>
  <effect>
    <object-type>all</object-type>
    <effects-menu><submenu name="Grades e Linhas"/></effects-menu>
    <menu-tip>Move o centro de cada objeto selecionado até a guia mais próxima.</menu-tip>
    <icon>inksvector_grids_snap_guides.svg</icon>
  </effect>
  <script><command location="inx" interpreter="python">inksvector_grids.py</command></script>
</inkscape-extension>
